        <condition/>
        <description>Sets Target Resolution to 48 hours from now for Water and Electricity grievances, and 72 hours from now for Sanitation and Roads grievances.</description>
        <execute_function>false</execute_function>
        <filter_condition table="x_1850267_public_0_grievance">grievance_categoryINwater,electricity,sanitation,roads<item display_value="water,electricity,sanitation,roads" endquery="false" field="grievance_category" goto="false" newquery="false" operator="IN" or="false" value="water,electricity,sanitation,roads"/>
        </filter_condition>
        <is_rest>false</is_rest>
        <message/>
        <name>Calculate SLA Deadline</name>
        <order>100</order>
        <priority>100</priority>
        <rest_method/>
        <rest_method_text/>
        <rest_service/>
        <rest_service_text/>
        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // SLA resolution window, in hours, keyed by grievance category value.
    var SLA_HOURS_BY_CATEGORY = {
        water: 48,
        electricity: 48,
        sanitation: 72,
        roads: 72,
    };

    var SECONDS_PER_HOUR = 3600;

    var category = current.getValue('grievance_category');

    if (!category) {
        return;
    }

    var slaHours = SLA_HOURS_BY_CATEGORY[category];

    if (!slaHours) {
        return;
    }

    var deadline = new GlideDateTime();
    deadline.addSeconds(slaHours * SECONDS_PER_HOUR);

    current.setValue('target_resolution', deadline.getValue());
})(current, previous);
]]></script>
